{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aradhya (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port", "8080", "--dart-define-from-file=.env"]
    },
    {
      "name": "Aradhya (localhost:8080, release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "flutterMode": "release",
      "args": ["--web-port", "8080", "--dart-define-from-file=.env"]
    }
  ]
}
